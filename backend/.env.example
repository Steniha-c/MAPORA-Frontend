# MAPORA Backend Environment Configuration

APP_NAME="MAPORA Backend"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="CHANGE_ME_GENERATE_A_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial Admin
INITIAL_ADMIN_EMAIL="CHANGE_ME_ADMIN_EMAIL"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=mapora
DATABASE_URL="postgresql+psycopg://postgres:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/mapora"
SQL_ECHO=false

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Storage
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./storage_data"

# S3 / MinIO
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_BUCKET_NAME="mapora-uploads"
S3_REGION_NAME="us-east-1"
S3_SECURE=false

# Video Upload
MAX_UPLOAD_SIZE_BYTES=524288000

# Computer Vision
DEVICE="cpu"
MIDAS_MODEL_TYPE="MiDaS_small"
KEYFRAME_MIN_INTERVAL_SECONDS=0.5
KEYFRAME_BLUR_THRESHOLD=100.0
KEYFRAME_FEATURE_DIFF_RATIO=0.25
MODEL_WEIGHTS_DIR="./models_cache"
